{
  "name": "backend",
  "version": "2.0.4",
  "description": "Express application for the MAU Arkiv project",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "build": "npm run build-frontend && npm run copy-frontend && tsc && npm run copy-assets",
    "build-frontend": "npm run build --prefix ../frontend",
    "copy-assets": "cp -r public dist/public",
    "copy-frontend": "cp -r ../frontend/dist/browser/* public/",
    "dev": "tsx watch src/app.ts",
    "typecheck": "tsc --noEmit",
    "test:logging": "tsx scripts/test-logging.ts",
    "migrate:make": "node --import tsx ../node_modules/knex/bin/cli.js migrate:make --knexfile src/core/config/knex-config.ts -x ts",
    "migrate:latest:dev": "node --import tsx ../node_modules/knex/bin/cli.js migrate:latest --knexfile src/core/config/knex-config.ts",
    "migrate:rollback:dev": "node --import tsx ../node_modules/knex/bin/cli.js migrate:rollback --knexfile src/core/config/knex-config.ts",
    "migrate:latest": "knex migrate:latest --knexfile dist/core/config/knex-config.js",
    "migrate:rollback": "knex migrate:rollback --knexfile dist/core/config/knex-config.js"
  },
  "dependencies": {
    "@mau-arkiv/shared": "file:../shared",
    "@types/csurf": "^1.11.5",
    "@types/express-session": "^1.18.2",
    "@types/saml2-js": "^3.0.4",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "hjson": "^3.2.2",
    "knex": "^3.3.0",
    "mssql": "^12.7.0",
    "reflect-metadata": "^0.2.2",
    "saml2-js": "^4.0.4",
    "tedious": "^20.0.0",
    "tsyringe": "^4.10.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xml2js": "^0.6.2",
    "config": "^4.1.1"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hjson": "^2.4.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^16.11.7",
    "@types/winston": "^2.4.4",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "author": "",
  "license": "ISC"
}
